# ==============================================================================
# MBDigital Arcade - Environment Configuration (.env.example)
# ==============================================================================

# --- 1. REAL AD MONETIZATION (Earn Real Fiat / Cash from Players) ---
# Sign up at https://adsense.google.com or Google AdSense for Games (H5 Games Ads).
# Once approved, paste your Publisher ID below (starts with ca-pub-).
# When this ID is present, real video ads will serve to players and deposit CPM earnings to your account.
# If omitted or empty, the arcade automatically runs high-fidelity cyberpunk sponsor simulations.
VITE_ADSENSE_PUB_ID=ca-pub-XXXXXXXXXXXXXXXX
VITE_ADSENSE_CHANNEL_ID=

# Optional: AdinPlay Game ID for web arcade monetization
VITE_ADINPLAY_GAME_ID=

# --- 2. CLOUD DATABASE & MULTIPLAYER (Supabase Cloud) ---
# Create a free project at https://supabase.com for cloud saves and global leaderboards.
# Copy and paste your project URL and Anon Public Key below.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
